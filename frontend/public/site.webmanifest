{
  "name": "AlgoStudio — program execution visualizer",
  "short_name": "AlgoStudio",
  "description": "Step backwards through a running Python program. Views inferred from the data's shape at runtime.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "orientation": "any",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
