# The API image.
#
# It is NOT the sandbox. The sandbox is Dockerfile.runtime, and this image
# spawns it: with ALGOSTUDIO_SANDBOX=docker it needs the host Docker socket
# mounted (see docker-compose.prod.yml). Without that socket, run it with
# ALGOSTUDIO_ALLOW_ARBITRARY_CODE=0 so only the bundled catalogue executes.
#
# Two useful targets:
#   api-base  backend only, for development next to a Vite dev server
#   api       (default) backend + the built SPA served from the same origin
#             by api/app.py::_mount_frontend -- one container, one port
#
# Build from the repository root:
#   docker build -f backend/Dockerfile.api -t algostudio-api:latest .

# ---- stage 1: build the SPA ------------------------------------------------
FROM node:20-slim AS web

# Canonical URLs, Open Graph tags and the sitemap are absolute by
# specification, so the build has to be told where it will be served from.
# A canonical pointing at the wrong origin is worse than none at all, which is
# why this is an explicit argument with a default rather than a guess.
# The live deployment. Render appended a suffix when the service was
# created, and the name is part of the hostname -- so this is the actual
# origin, not the one the service was named after. Override with
# --build-arg VITE_SITE_URL=... for any other deployment.
ARG VITE_SITE_URL=https://algostudio-wu5c.onrender.com
# Cookieless analytics, off unless a source is supplied. Empty means the built
# pages contain no third-party request at all.
ARG VITE_ANALYTICS_SRC=""
ARG VITE_ANALYTICS_DOMAIN=""
ENV VITE_SITE_URL=$VITE_SITE_URL \
    VITE_ANALYTICS_SRC=$VITE_ANALYTICS_SRC \
    VITE_ANALYTICS_DOMAIN=$VITE_ANALYTICS_DOMAIN

WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Fail the build rather than ship pages whose canonical tag is a placeholder.
# A wrong canonical is silent: the page renders, and search engines quietly
# attribute it to another origin.
RUN grep -q "$VITE_SITE_URL" dist/sitemap.xml \
 && ! grep -rq "%SITE_URL%" dist/ \
 && echo "site built for $VITE_SITE_URL"

# ---- stage 2: the backend --------------------------------------------------
FROM python:3.12-slim AS api-base

# The docker CLI -- never the daemon -- is what DockerSandbox shells out to for
# ALGOSTUDIO_SANDBOX=docker. It costs roughly 250 MB, and a curated deployment
# executes nothing a visitor wrote, so it needs no container boundary and
# should leave this out. It defaults to OFF: a tool that grants control of the
# host daemon is opt-in, and the compose files that need it ask for it.
ARG INSTALL_DOCKER_CLI=0
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && if [ "$INSTALL_DOCKER_CLI" = "1" ]; then \
      apt-get install -y --no-install-recommends docker.io; \
    fi \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/ /app/backend/
# Editable, so the plugin directories keep their explain.md and source.py where
# the registry expects them, while dependencies still come from pyproject.toml
# rather than being restated here and drifting.
RUN pip install --no-cache-dir -e "./backend[ai]"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ALGOSTUDIO_DATA=/data

RUN mkdir -p /data
VOLUME ["/data"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health',timeout=4).status==200 else 1)"

CMD ["python", "-m", "uvicorn", "algostudio.api.app:app", \
     "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]

# ---- stage 3: backend + SPA ------------------------------------------------
FROM api-base AS api
# _mount_frontend resolves <repo>/frontend/dist relative to the package, so the
# built SPA has to land in exactly this path.
COPY --from=web /web/dist /app/frontend/dist
