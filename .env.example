# AlgoStudio configuration.  Copy to .env and edit; .env is gitignored.
# Every setting is read in backend/algostudio/config.py, and every one has a
# working default -- this file exists to make the deployment-relevant ones
# visible, not because they are required.

# ---------------------------------------------------------------- the two
# that decide whether a deployment is safe.  See docs/20-deployment.md.

# "subprocess" (default) or "docker".  Subprocess isolation is a budget and
# policy layer, NOT a security boundary: CPython cannot be sandboxed in
# process.  Docker mode is what makes the guarantee real.
ALGOSTUDIO_SANDBOX=docker

# 1 = visitors may run source they typed.  0 = curated mode: the 49 bundled
# algorithms still run, POST /executions and POST /analyze return 403.
# Curated mode is the honest way to publish a link with no container boundary.
ALGOSTUDIO_ALLOW_ARBITRARY_CODE=1

# ---------------------------------------------------------------- serving
# Comma-separated browser origins, or "none" when this process serves the SPA
# itself (the single-container deployment), or "*" for local development.
ALGOSTUDIO_CORS_ORIGINS=none

# Where recordings and the SQLite database live.  Must be writable and, on a
# container deployment, must be a volume -- executions are the only state.
ALGOSTUDIO_DATA=/data

# Delete recordings older than this many days.  0 disables expiry.
ALGOSTUDIO_RETENTION_DAYS=14

# ---------------------------------------------------------------- budgets
# Per execution.  These are the backstop against a runaway program; the
# sandbox enforces them, the API does not have to trust them.
ALGOSTUDIO_MAX_SECONDS=10
ALGOSTUDIO_MAX_EVENTS=200000
ALGOSTUDIO_MAX_MEMORY_MB=256
ALGOSTUDIO_MAX_SOURCE=262144

# Per client IP, per minute, counted in process (single node by design).
ALGOSTUDIO_RATE_RUNS=30
ALGOSTUDIO_RATE_AI=20
ALGOSTUDIO_CONCURRENCY=4

# ------------------------------------------------------- analytics (build)
# These are read by Vite at BUILD time, not by the server, because the tags
# they produce are baked into the HTML.
#
# Unset -- the default -- means the pages contain no third-party request at
# all, and no cookie banner, because there is nothing to consent to.
# VITE_ANALYTICS_SRC=https://plausible.io/js/script.js
# VITE_ANALYTICS_DOMAIN=your-domain.example
#
# Set this to 1 ONLY for a provider that stores something on the visitor's
# device (Google Analytics and similar). It changes what is emitted: the
# script is no longer loaded on page load, and a consent bar is shipped that
# loads it after an explicit yes, remembers a no, and can be reopened.
# VITE_ANALYTICS_CONSENT=0

# The absolute origin the build will be served from. Canonical tags, Open
# Graph URLs and sitemap.xml are absolute by specification, and a canonical
# pointing at the wrong origin is worse than none at all.
# VITE_SITE_URL=https://algostudio.onrender.com

# ---------------------------------------------------------------- AI tutor
# With no key the tutor falls back to the template explainer, which is built
# from the event stream and needs no network.  The app is fully usable that
# way -- that fallback is a design property, not a degraded mode.
ALGOSTUDIO_AI=1
# ANTHROPIC_API_KEY=
ALGOSTUDIO_AI_MODEL=claude-sonnet-5
